{
  "name": "learnlab",
  "description": "LearnLab, a lightweight Learning Management System: course management and catalog, student enrollment, lessons, quizzes and assessments, progress tracking, and basic administration. Python 3.12 FastAPI backend with SQLite, React TypeScript Vite frontend, pytest, Vitest and Playwright. Internal application, local verification, no Docker.",
  "stack": {
    "backend": {
      "language": "python",
      "version": "3.12",
      "framework": "fastapi",
      "package_manager": "uv",
      "linter": "ruff",
      "typechecker": "mypy",
      "test_runner": "pytest"
    },
    "frontend": {
      "language": "typescript",
      "version": "",
      "framework": "react",
      "package_manager": "npm",
      "linter": "",
      "typechecker": "tsc",
      "test_runner": "vitest"
    },
    "database": {
      "primary": "sqlite",
      "secondary": null
    }
  },
  "architecture": {
    "layers": ["types", "config", "repository", "service", "api", "ui"],
    "layer_roots": ["backend/src", "frontend/src"]
  },
  "lsp": {
    "servers": [
      {
        "language": "python",
        "server": "pyright",
        "binary": "pyright",
        "install": "npm i -g pyright"
      },
      {
        "language": "typescript",
        "server": "typescript-language-server",
        "binary": "typescript-language-server",
        "install": "npm i -g typescript-language-server typescript"
      }
    ]
  },
  "evaluation": {
    "api_base_url": "http://localhost:8000",
    "ui_base_url": "http://localhost:3000",
    "health_check": "/health",
    "design_score_threshold": 7,
    "design_max_iterations": 3,
    "test_corpus_dir": "specs/test_artefacts"
  },
  "execution": {
    "default_mode": "full",
    "model_tier": "balanced",
    "ceremony": "trimmed",
    "session_chaining": true,
    "teammate_model": "sonnet",
    "// budget": "unset — /auto uses the model_tier default cap (cost tier ~= 80 agents / $8 / 30 min). To enforce a per-build ceiling, replace this key with  budget: { est_cost_usd, agents, wall_clock_ms }  — or pass --budget at run time. See docs/token-cost-playbook.md."
  },
  "verification": {
    "e2e_targets": [],
    "mode": "local",
    "local": {
      "backend_url": "http://localhost:8000",
      "frontend_url": "http://localhost:3000",
      "start_commands": []
    }
  },
  "topology": "web-app",
  "quality": {
    "sensor_tier": "standard",
    "test_discipline": "outcomes",
    "agent_readiness": {
      "mode": "report",
      "min_active_pillars": 3,
      "forbid_regression": false
    },
    "sast_engine": "semgrep",
    "mutation": {
      "tool": "mutmut",
      "config_file": "pyproject.toml",
      "critical_globs": []
    }
  },
  "token_governor": {
    "enabled": true,
    "mode": "enforced",
    "living_navigation": true,
    "context_search_required": true,
    "max_source_read_lines": 300,
    "tool_output_token_estimates": true,
    "compress_tool_output": true,
    "ccr_enabled": true,
    "preserve_full_outputs": true,
    "budget_warn_pct": 80
  },
  "observability": {
    "enabled": true,
    "metrics_path": "/metrics",
    "red_labels": [
      "method",
      "route",
      "status"
    ],
    "slo": {
      "error_rate_pct": 1,
      "p95_ms": 500
    }
  },
  "framework_skill_packs": [
    "fastapi-code",
    "react-code"
  ],
  "custom_sensors": [],
  "github": {
    "org": "",
    "default_branch": "main",
    "required_checks": [
      "gitleaks",
      "sast"
    ],
    "required_approvals": 1,
    "require_code_owner_review": false,
    "enforce_admins": true,
    "ruleset_scope": "org",
    "ruleset_name": "harness-baseline-protection",
    "target_repos": "~ALL",
    "default_owners": [],
    "environments": [
      {
        "name": "production",
        "reviewers": [],
        "wait_timer": 0,
        "protected_branches": true
      }
    ]
  },
  "harness_version": null
}
